# ─── 로컬 백엔드(Supabase local) + Admin ───
# Supabase CLI: https://supabase.com/docs/guides/local-development
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=여기에_supabase_start_실행_후_표시되는_anon_key_입력

# 루트(/)에 표시할 주인의 사용자 아이디 (/u/아이디 로 만든 것과 같은 값)
# 비워두면 기존 content_blocks(mock 동기화) 모드로 동작
VITE_OWNER_USERNAME=

# /admin 접속 키 (단일 소유자 시절 잔재 — 현재는 이메일 로그인 사용, 무시해도 됨)
VITE_ADMIN_KEY=local-admin
